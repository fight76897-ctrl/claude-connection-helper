{
  "name": "claude-connection-helper",
  "productName": "Claude Connection Helper",
  "version": "0.2.1",
  "private": true,
  "description": "Local chained proxy and launcher for Claude tools on Windows",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-packager . ClaudeConnectionHelper --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=^/tests --ignore=^/docs --ignore=^/dist --ignore=^/artifacts --ignore=^/node_modules --ignore=^/release",
    "postpackage": "node scripts/package-extras.cjs",
    "installer": "electron-builder --prepackaged dist/ClaudeConnectionHelper-win32-x64 --win nsis --x64 --publish never --config electron-builder.json"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  }
}
